    "name": "Retiro Escolar Seguro - API A+B",
    "description": "Colección automatizada para Bloque A (autenticación) y Bloque B (instituciones y cuentas). Requiere preparar scripts/seed_demo.py antes de ejecutar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.environment.get('base_url');",
          "if (!pm.request.headers.has('Accept')) pm.request.headers.upsert({key: 'Accept', value: 'application/json'});",
          "if (pm.request.method !== 'GET' && pm.request.method !== 'HEAD') {",
          "const csrf = pm.environment.get('csrf_token') || pm.cookies.get('csrftoken');",
          "  if (csrf) pm.request.headers.upsert({key: 'X-CSRFToken', value: csrf});",
          "  pm.request.headers.upsert({key: 'Referer', value: base + '/'});",
          "}"
        ]
      }
    }
  ],
