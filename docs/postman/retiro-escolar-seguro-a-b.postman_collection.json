                "type": "text/javascript",
                "exec": [
                  "pm.test('Swagger disponible', () => pm.response.to.have.status(200));",
                  "const cookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const match = cookie.match(/csrftoken=([^;]+)/);",
                  "if (match) pm.environment.set('csrf_token', match[1]);"
                ]
              }
            }
          ]
        }
      ]
