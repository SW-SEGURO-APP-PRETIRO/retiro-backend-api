# Copia este archivo a .env y completa los valores. El .env real NUNCA se sube al repositorio.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-de-50-caracteres-o-mas
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443

# Clave Fernet para cifrar secretos TOTP y fotos
FIELD_ENCRYPTION_KEY=
# Clave para las firmas HMAC de cuidadores y autorizaciones
HMAC_SIGNING_KEY=

# --- SQL Server ---
# Contraseña del usuario administrador del contenedor (mínimo 8, con mayúscula, minúscula, número y símbolo)
MSSQL_SA_PASSWORD=Cambia#Esta1Clave
DB_NAME=retiro_escolar
DB_USER=retiro_app
DB_PASSWORD=Cambia#Esta2Clave
DB_HOST=localhost
DB_PORT=1433

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Datos de demostración ---
SEED_PASSWORD=ClaveDemo#2026